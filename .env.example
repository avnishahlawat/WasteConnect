# ============================================================
# WasteConnect — Environment Variables Template
# Copy this file to .env (never commit .env to source control)
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# Local development
MONGODB_URI=mongodb://localhost:27017/wasteconnect
# MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wasteconnect?retryWrites=true&w=majority

# ---- JWT ----
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production
JWT_EXPIRES_IN=7d

# ---- CORS ----
CLIENT_URL=http://localhost:5173

# ---- File Uploads ----
MAX_FILE_SIZE_MB=5
MAX_FILES_PER_REQUEST=5
UPLOAD_DIR=uploads

# ---- Rate Limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---- AI Providers (optional — app works without these) ----
AI_PROVIDER=mock
# Options: mock | openai | gemini

# OpenAI (optional)
OPENAI_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=

# ---- ML Service (optional) ----
ML_SERVICE_URL=http://localhost:8000

# ---- Email (future — not required for V1) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@wasteconnect.io
